 'pyplot' du module 'matplotlib',\n# et renommage en 'plt'\nimport matplotlib.pyplot as plt\n\n# Abscisses sur lesquelles sera calculée la sinusoïde :\n# un point tous les 0,1 s entre 0 et 10 s\nn = np.arange(0, 10, 0.1)\n\n# Fréquence de la sinusoïde\nf = 0.3\n\n# Sinusoïde : c'est tout simple, il suffit d'écrire\n# l'expression mathématique 😎\nx = np.sin(2*np.pi*f*n)\n\n# Création d'une figure, dont on définit la taille\nplt.figure(figsize=(6,3))\n\n# Affichage de la sinusoïde (dans la figure créée)\nplt.plot(n, x, label=\"sinusoïde\")\n\n# Légende\nplt.legend()\n\n# Légende des axes et titre\nplt.xlabel(\"$n$\")\nplt.ylabel(\"$x[n]$\")\nplt.title(\"Une belle sinusoïde\")\n\n# Affichage (pas toujours nécessaire, mais parfois indispensable)\nplt.show()","identifier":"toto-code","enumerator":"1","html_id":"toto-code","key":"Xo03RpUGq0"},{"type":"outputs","id":"S325rgwR-Ho3C0k4uuB13","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b21d3e1237cbb13b65dd622d39152e3b","path":"/b21d3e1237cbb13b65dd622d39152e3b.png"},"text/plain":{"content":"<Figure size 600x300 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"toto-outputs-0","html_id":"toto-outputs-0","key":"J8ZFNhrY9v"}],"identifier":"toto-outputs","html_id":"toto-outputs","key":"SOEW2U1is5"}],"identifier":"toto","label":"toto","html_id":"toto","key":"ZfNdRxMNAg"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cellules à intégrer dans les pages","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yVDmlIocnY"}],"identifier":"cellules-int-grer-dans-les-pages","label":"Cellules à intégrer dans les pages","html_id":"cellules-int-grer-dans-les-pages","implicit":true,"key":"Xy0m35A29o"}],"visibility":"remove","key":"wJCqwZ8Vu